{
  "name": "leetgrasp",
  "displayName": "LeetGrasp",
  "description": "Scaffold, test, and submit LeetCode problems in Python from VS Code — with an Anki-inspired rating step that drives a hardest-first practice queue.",
  "version": "0.2.0",
  "publisher": "khoa-doan",
  "author": {
    "name": "Khoa Doan"
  },
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/DNT-Khoa/leetgrasp.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "keywords": [
    "leetcode",
    "python",
    "interview-prep",
    "spaced-repetition"
  ],
  "categories": [
    "Programming Languages",
    "Testing"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "leetgrasp.init",
        "title": "LeetGrasp: Initialize Workspace"
      },
      {
        "command": "leetgrasp.newProblem",
        "title": "LeetGrasp: New Problem from URL"
      },
      {
        "command": "leetgrasp.searchLeetcode",
        "title": "LeetGrasp: Search LeetCode"
      },
      {
        "command": "leetgrasp.runTests",
        "title": "LeetGrasp: Run Tests",
        "icon": "$(play)"
      },
      {
        "command": "leetgrasp.submit",
        "title": "LeetGrasp: Submit",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "leetgrasp.resetProblem",
        "title": "LeetGrasp: Reset Problem",
        "icon": "$(discard)"
      },
      {
        "command": "leetgrasp.pickRandom",
        "title": "LeetGrasp: Pick Random Practice Problem",
        "icon": "$(getting-started-beginner)"
      },
      {
        "command": "leetgrasp.setLeetcodeCookies",
        "title": "LeetGrasp: Set LeetCode Cookies"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "leetgrasp",
          "title": "LeetGrasp",
          "icon": "media/icon-sidebar.svg"
        }
      ]
    },
    "views": {
      "leetgrasp": [
        {
          "id": "leetgrasp.practice",
          "name": "Practice"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "leetgrasp.runTests",
          "when": "leetgrasp.activeIsProblem"
        },
        {
          "command": "leetgrasp.submit",
          "when": "leetgrasp.activeIsProblem"
        },
        {
          "command": "leetgrasp.resetProblem",
          "when": "leetgrasp.activeIsProblem"
        }
      ],
      "editor/title": [
        {
          "command": "leetgrasp.runTests",
          "when": "leetgrasp.activeIsProblem",
          "group": "navigation@1"
        },
        {
          "command": "leetgrasp.submit",
          "when": "leetgrasp.activeIsProblem",
          "group": "navigation@2"
        },
        {
          "command": "leetgrasp.resetProblem",
          "when": "leetgrasp.activeIsProblem",
          "group": "navigation@3"
        }
      ],
      "view/title": [
        {
          "command": "leetgrasp.pickRandom",
          "when": "view == leetgrasp.practice",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
